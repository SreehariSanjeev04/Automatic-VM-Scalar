{
  "libvirt": {
    "uri": "qemu:///system",
    "storage_pool": "images",
    "base_image": "/mnt/LinuxData/images/base.qcow2"
  },
  "vm": {
    "initial_name": "vm",
    "vcpus": 1,
    "memory_mib": 1024,
    "initial_replicas": 1,
    "max_replicas": 2,
    "guest_port": 8080,
    "replica_name_prefix": "vm-",
    "work_path": "/binary-trees"
  },
  "scaling": {
    "scale_in_enabled": false,
    "scale_out_cpu_threshold": 75.0,
    "scale_in_cpu_threshold": 25.0,
    "required_overload_count": 3,
    "required_low_load_count": 5,
    "monitor_interval_seconds": 2,
    "warmup_seconds": 30,
    "cooldownSeconds": 10
  },
  "network": {
    "load_balancer_host": "192.168.122.1",
    "load_balancer_port": 8080,
    "load_balancer_bind_address": "0.0.0.0",
    "load_balancer_path": "/work",
    "connection_timeout_seconds": 2,
    "request_timeout_seconds": 30
  },
  "traffic": {
    "high_threads": 10,
    "high_requests_per_thread": 300,
    "high_value": 16,
    "high_request_delay_milliseconds": 500,
    "low_requests_per_thread": 1,
    "low_value": 2,
    "low_request_delay_milliseconds": 1000
  },
  "metrics": {
    "file_path": "results/vm_metrics.csv"
  }
}
