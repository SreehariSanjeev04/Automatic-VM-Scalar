{
  "libvirt": {
    "uri": "qemu:///system",
    "storage_pool": "default",
    "base_image": "/var/lib/libvirt/images/autoscaler-base.qcow2"
  },
  "vm": {
    "initial_name": "ubuntu_base",
    "vcpus": 1,
    "memory_mib": 1024,
    "initial_replicas": 1,
    "max_replicas": 2,
    "guest_port": 8080,
    "replica_name_prefix": "autoscaler-",
    "work_path": "/binary-trees"
  },
  "scaling": {
    "scale_out_cpu_threshold": 75.0,
    "scale_in_cpu_threshold": 25.0,
    "required_overload_count": 3,
    "required_low_load_count": 5,
    "monitor_interval_seconds": 2,
    "warmup_seconds": 30,
    "cooldown_seconds": 30,
    "drain_timeout_seconds": 60,
    "readiness_timeout_seconds": 120,
    "scale_in_enabled": true
  },
  "network": {
    "load_balancer_host": "192.168.122.1",
    "load_balancer_port": 8080,
    "load_balancer_bind_address": "0.0.0.0",
    "load_balancer_path": "/work",
    "connection_timeout_seconds": 2,
    "request_timeout_seconds": 30,
    "client_timeout_seconds": 35
  },
  "traffic": {
    "high_threads": 8,
    "high_requests_per_thread": 1,
    "high_value": 14,
    "low_requests_per_thread": 1,
    "low_value": 14,
    "low_request_delay_milliseconds": 2000,
    "high_rate": 8.0,
    "low_rate": 0.8,
    "queue_capacity": 32,
    "high_request_delay_milliseconds": 1000
  },
  "state_file": ".autoscaler-state.json",
  "metrics_directory": "runs/current",
  "metrics": {
    "file_path": "results/vm_metrics.csv"
  }
}
